# Server
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database: Supabase (optional) ---
# Fill these in to switch the app from local SQLite (auth.db) to Supabase.
# Get them from: Supabase Dashboard -> Project Settings -> API
# Run supabase/schema.sql in the SQL Editor first to create the tables.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Use ONE of the keys below (secret/service_role preferred for server-side writes).
# New-style keys look like: sb_secret_xxx / sb_publishable_xxx
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Email OTP via SMTP (optional) ---
# If unset, OTPs are printed to the server console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Auth App <your_email@gmail.com>"

# --- SMS OTP via Twilio (optional) ---
# If unset, SMS OTPs are printed to the server console instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
