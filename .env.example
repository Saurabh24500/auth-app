# Server
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database: Supabase (optional) ---
# Fill these in to switch the app from local SQLite (auth.db) to Supabase.
# Get them from: Supabase Dashboard -> Project Settings -> API
# Run supabase/schema.sql in the SQL Editor first to create the tables.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Use ONE of the keys below (secret/service_role preferred for server-side writes).
# New-style keys look like: sb_secret_xxx / sb_publishable_xxx
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Email OTP via SMTP (optional) ---
# If unset, OTPs are printed to the server console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Auth App <your_email@gmail.com>"

# --- SMS OTP via Firebase Phone Auth (optional, free tier) ---
# Up to 10,000 SMS verifications/month for free, global.
# Get from Firebase console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Public web config: Project Settings -> General -> Your apps -> Web app
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
